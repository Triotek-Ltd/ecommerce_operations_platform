{
  "confirm": [
    {
      "type": "create_record",
      "effect_id": "order_status_event_confirmed",
      "target_doc": "order_status_event",
      "lookup": {
        "reference_no": {
          "$template": "ORDSTAT-{order_code|reference_no|pk}-confirmed"
        }
      },
      "values": {
        "title": {
          "$template": "Order Status Confirmed {order_code|reference_no|pk}"
        },
        "reference_no": {
          "$template": "ORDSTAT-{order_code|reference_no|pk}-confirmed"
        },
        "source_order": {
          "$from": [
            "order_code",
            "reference_no",
            "pk"
          ]
        },
        "event_type": "confirmed",
        "event_timestamp": {
          "$today": true
        },
        "normalized_status": "confirmed",
        "workflow_state": "active"
      }
    }
  ],
  "cancel": [
