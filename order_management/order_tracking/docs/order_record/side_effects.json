  "archive": [
    {
      "type": "update_current",
      "fields": {
        "workflow_state": "archived"
      }
    }
  ],
  "update_status": [
    {
      "type": "create_record",
      "effect_id": "order_status_event_updated",
      "target_doc": "order_status_event",
      "lookup": {
        "reference_no": {
          "$template": "ORDSTAT-{order_code|reference_no|pk}-status"
